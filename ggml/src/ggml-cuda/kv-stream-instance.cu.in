#define KV_STREAM_VALUE(V) case GGML_TYPE_##V: return queries == 1 ? flash_attn_ext_vec_resume<256,1,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V,false> : queries == 2 ? flash_attn_ext_vec_resume<256,2,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V,false> : nullptr;
#if GGML_CUDA_FA_@KV_STREAM_KEY@_F16
        KV_STREAM_VALUE(F16)
