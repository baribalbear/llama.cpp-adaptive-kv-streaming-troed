#include "ggml-cuda/kv-stream-dispatch.cuh"
#include "ggml-cuda/fattn-vec.cuh"

// Native span kernels follow the compiled FA pair set. GGML_CUDA_FA_QUANTS selects which
// K/V combinations are built and upstream emits GGML_CUDA_FA_<type_K>_<type_V> for every
// combination, 0 or 1. A pair outside the set returns nullptr; the caller then falls back
// to the F16 conversion path or rejects the pair, instead of linking a kernel that was
// never compiled. GGML_CUDA_FA_ALL_QUANTS no longer exists, so do not gate on it.

// One translation unit per key type keeps native-pair compilation parallel and bounded.
fattn_kernel_t ggml_cuda_kv_stream_kernel_@KV_STREAM_KEY@(ggml_type value) {
#ifdef GGML_CUDA_NO_FA
    GGML_UNUSED(value);
    return nullptr;
#else
    switch (value) {
#define KV_STREAM_VALUE(V) case GGML_TYPE_##V: return flash_attn_ext_vec<256,1,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V,false>;
#if GGML_CUDA_FA_@KV_STREAM_KEY@_F16
        KV_STREAM_VALUE(F16)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_BF16
        KV_STREAM_VALUE(BF16)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q4_0
        KV_STREAM_VALUE(Q4_0)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q4_1
        KV_STREAM_VALUE(Q4_1)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q5_0
        KV_STREAM_VALUE(Q5_0)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q5_1
        KV_STREAM_VALUE(Q5_1)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q8_0
        KV_STREAM_VALUE(Q8_0)
#endif
#undef KV_STREAM_VALUE
        default: return nullptr;
    }
#endif
}

// Stock vector specialization used only to match ordinary split-count selection.
fattn_kernel_t ggml_cuda_kv_stream_vector_kernel_@KV_STREAM_KEY@(ggml_type value, uint32_t queries) {
#ifdef GGML_CUDA_NO_FA
    GGML_UNUSED(value); GGML_UNUSED(queries);
    return nullptr;
#else
    switch (value) {
#define KV_STREAM_VALUE(V) case GGML_TYPE_##V: return queries == 1 ? \
            flash_attn_ext_vec<256,1,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V,false> : queries == 2 ? \
            flash_attn_ext_vec<256,2,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V,false> : nullptr;
#if GGML_CUDA_FA_@KV_STREAM_KEY@_F16
        KV_STREAM_VALUE(F16)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_BF16
        KV_STREAM_VALUE(BF16)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q4_0
        KV_STREAM_VALUE(Q4_0)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q4_1
        KV_STREAM_VALUE(Q4_1)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q5_0
        KV_STREAM_VALUE(Q5_0)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q5_1
        KV_STREAM_VALUE(Q5_1)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q8_0
        KV_STREAM_VALUE(Q8_0)
#endif
#undef KV_STREAM_VALUE
        default: return nullptr;
    }
#endif
}

// Fixed one/two/three-span vector specialization keeps one stock reduction and launch.
ggml_kv_vector_span_kernel_t ggml_cuda_kv_stream_vector_span_kernel_@KV_STREAM_KEY@(
        ggml_type value, uint32_t queries, uint32_t spans) {
#ifdef GGML_CUDA_NO_FA
    GGML_UNUSED(value); GGML_UNUSED(queries); GGML_UNUSED(spans);
    return nullptr;
#else
#define KV_STREAM_SPANS(V)                                                                                    \
        case GGML_TYPE_##V: switch (spans) {                                                                  \
            case 1: return queries == 1 ? flash_attn_ext_vec_spans<256,1,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V,1> : nullptr; \
            case 2: return queries == 1 ? flash_attn_ext_vec_spans<256,1,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V,2> : nullptr; \
            case 3: return queries == 1 ? flash_attn_ext_vec_spans<256,1,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V,3> : nullptr; \
            case 4: return queries == 1 ? flash_attn_ext_vec_spans<256,1,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V,4> : nullptr; \
            default: return nullptr;                                                                          \
        }
    switch (value) {
#if GGML_CUDA_FA_@KV_STREAM_KEY@_F16
        KV_STREAM_SPANS(F16)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_BF16
        KV_STREAM_SPANS(BF16)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q4_0
        KV_STREAM_SPANS(Q4_0)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q4_1
        KV_STREAM_SPANS(Q4_1)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q5_0
        KV_STREAM_SPANS(Q5_0)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q5_1
        KV_STREAM_SPANS(Q5_1)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q8_0
        KV_STREAM_SPANS(Q8_0)
#endif
        default: return nullptr;
    }
#undef KV_STREAM_SPANS
#endif
}

// One translation unit per key type keeps native-pair compilation parallel and bounded.
ggml_kv_resume_kernel_t ggml_cuda_kv_stream_resume_kernel_@KV_STREAM_KEY@(ggml_type value, uint32_t queries) {
#ifdef GGML_CUDA_NO_FA
    GGML_UNUSED(value); GGML_UNUSED(queries);
    return nullptr;
#else
    switch (value) {
#define KV_STREAM_VALUE(V) case GGML_TYPE_##V: return queries == 1 ? \
            flash_attn_ext_vec_resume<256,1,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V> : queries == 2 ? \
            flash_attn_ext_vec_resume<256,2,GGML_TYPE_@KV_STREAM_KEY@,GGML_TYPE_##V> : nullptr;
#if GGML_CUDA_FA_@KV_STREAM_KEY@_F16
        KV_STREAM_VALUE(F16)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_BF16
        KV_STREAM_VALUE(BF16)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q4_0
        KV_STREAM_VALUE(Q4_0)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q4_1
        KV_STREAM_VALUE(Q4_1)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q5_0
        KV_STREAM_VALUE(Q5_0)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q5_1
        KV_STREAM_VALUE(Q5_1)
#endif
#if GGML_CUDA_FA_@KV_STREAM_KEY@_Q8_0
        KV_STREAM_VALUE(Q8_0)
#endif
#undef KV_STREAM_VALUE
        default: return nullptr;
    }
#endif
}

